# Applied on top of gki_defconfig for the ROM build of the GKI Image.
# Only the Image is built from source; all vendor modules stay the stock
# OS3.0 ones, so nothing here may change the KMI (exported symbol CRCs).

# Xiaomi gives these "default m", which leaks them into gki_defconfig.
# The stock xlogchar.ko is shipped with the vendor modules; spec_sync is
# not used. Keep the Image module-free.
# CONFIG_XLOGCHAR is not set
# CONFIG_QCOM_SPEC_SYNC is not set

# KernelSU-Next
CONFIG_KSU=y
