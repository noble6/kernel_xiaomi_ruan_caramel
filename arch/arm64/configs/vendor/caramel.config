# caramel: applied on top of gki_defconfig + vendor/ruan_rom.config.
# The stock OS3.0 vendor modules must keep loading, so nothing here may
# change the KMI (check vmlinux.symvers against their imports). In
# particular CONFIG_HZ stays 250: the modules have it compiled in.

CONFIG_LOCALVERSION="-caramel"
# Keep LOCALVERSION_AUTO: MODULE_SCMVERSION depends on it, and it adds a
# field to struct module, so turning it off breaks module_layout for
# every stock module.

# KernelSU + SUSFS
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# TCP: BBR as the default congestion control. It keeps throughput up on
# lossy Wi-Fi/mobile links, where cubic backs off on every lost packet.
# BBR paces internally, so it does not need the fq qdisc.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
# Off: TCP_CONG_ADVANCED would otherwise build these as modules.
# CONFIG_TCP_CONG_BIC is not set
# CONFIG_TCP_CONG_WESTWOOD is not set
# CONFIG_TCP_CONG_HTCP is not set
# CONFIG_TCP_CONG_HSTCP is not set
# CONFIG_TCP_CONG_HYBLA is not set
# CONFIG_TCP_CONG_VEGAS is not set
# CONFIG_TCP_CONG_NV is not set
# CONFIG_TCP_CONG_SCALABLE is not set
# CONFIG_TCP_CONG_LP is not set
# CONFIG_TCP_CONG_VENO is not set
# CONFIG_TCP_CONG_YEAH is not set
# CONFIG_TCP_CONG_ILLINOIS is not set
# CONFIG_TCP_CONG_DCTCP is not set
# CONFIG_TCP_CONG_CDG is not set

# NoMount: VFS path redirection for KernelSU modules (metamodule)
CONFIG_NOMOUNT=y

# BORE scheduler (built in, through the android_vh_bore_* hooks)
CONFIG_SCHED_BORE=y
